cmd_version() {
    print_header "Version Information"

    # Get from version-service if running
    local version_info=$(curl -s "http://localhost:8087/all" 2>/dev/null)
    if [ -n "$version_info" ]; then
        echo "$version_info" | python3 -m json.tool 2>/dev/null
    else
        # Fallback to pom.xml
        local version=$(grep -m1 '<version>' pom.xml | sed 's/.*<version>\(.*\)<\/version>.*/\1/')
        echo "  Version: $version"
        echo "  (version-service not running)"
    fi
    echo ""
}

# ============================================
# Parse Options
# ============================================
ARGS=()
while [ "$1" != "" ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=1
            ;;
        -q|--quiet)
            QUIET=1
            ;;
        -S|--simulate)
            SIMULATE=1
            ;;
        -h|--help)
            cmd_help
            exit 0
            ;;
        *)
            ARGS+=("$1")
            ;;
    esac
    shift
done

# ============================================
# Command Dispatcher
# ============================================
if [ ${#ARGS[@]} -eq 0 ]; then
    cmd_help
    exit 0
fi

CMD=${ARGS[0]}
CMDARGS=("${ARGS[@]:1}")

case "$CMD" in
    # Build commands
    build)
        cmd_build "${CMDARGS[@]}"
        ;;
    build-common)
        cmd_build_common
        ;;
    clean)
        cmd_clean
        ;;

    # Test commands
    test)
        cmd_test "${CMDARGS[@]}"
        ;;
    test-api)
        cmd_test_api
        ;;
    test-api-compare)
        cmd_test_api_compare
        ;;
    test-report)
        cmd_test_report
        ;;

    # Docker commands
    start|up)
        cmd_start "${CMDARGS[@]}"
        ;;
    stop|down)
        cmd_stop "${CMDARGS[@]}"
        ;;
    restart|bounce)
        cmd_restart "${CMDARGS[@]}"
        ;;
    rebuild)
        cmd_rebuild "${CMDARGS[@]}"
        ;;
    ps)
        cmd_ps
        ;;
    logs|log)
        cmd_logs "${CMDARGS[@]}"
        ;;

    # Status commands
    status)
        cmd_status
        ;;
    eureka)
        cmd_eureka
        ;;
    ports)
        cmd_ports
        ;;

    # Database commands
    db-shell|db|shell)
        cmd_db_shell
        ;;
    db-query|query)
        cmd_db_query "${CMDARGS[@]}"
        ;;
    db-volumes|volumes)
        cmd_db_volumes
        ;;
    db-clear|clear-cache)
        cmd_db_clear
        ;;

    # Config commands
    config)
        cmd_config "${CMDARGS[@]}"
        ;;
    config-refresh|refresh)
        cmd_config_refresh "${CMDARGS[@]}"
        ;;
    config-server-start)
        cmd_config_server_start
        ;;
    config-server-stop)
        cmd_config_server_stop
        ;;

    # Utility commands
    urls)
        cmd_urls
        ;;
    demo)
        cmd_demo "${CMDARGS[@]}"
        ;;
    version)
        cmd_version
        ;;
    help)
        cmd_help
        ;;

    *)
        print_error "Unknown command: $CMD"
        echo ""
        echo "Run '$prog help' for usage information"
        exit 1
        ;;
esac
