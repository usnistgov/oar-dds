#!/bin/bash
#
# oar-dds-ctl -- Control script for OAR Distribution Microservices
#
# Manage build, test, start, stop, and monitoring of all microservices.
#
set -e
prog=$(basename "$0")
execdir=$(dirname "$0")
[ "$execdir" = "" -o "$execdir" = "." ] && execdir=$PWD
cd "$execdir"

# ============================================
# Configuration
# ============================================
SERVICES=(
    "dataset-access"
    "aip-access"
    "bundle-plan"
    "data-bundle"
    "cache-mgmt"
    "restricted-access"
    "version-service"
)

INFRASTRUCTURE=(
    "eureka-server"
    "api-gateway"
)

COMMON_MODULES=(
    "shared-exceptions"
    "shared-models"
    "shared-utils"
    "cache-manager-client"
    "dataset-access-client"
)

# Get service port (bash 3 compatible)
get_service_port() {
    case $1 in
        config-server) echo 8888 ;;
        eureka-server) echo 8761 ;;
        api-gateway) echo 8080 ;;
        dataset-access) echo 8081 ;;
        aip-access) echo 8082 ;;
        bundle-plan) echo 8083 ;;
        data-bundle) echo 8084 ;;
        cache-mgmt) echo 8085 ;;
        restricted-access) echo 8086 ;;
        version-service) echo 8087 ;;
        postgres) echo 5433 ;;
        redis) echo 6379 ;;
        *) echo "" ;;
    esac
}

# Options
VERBOSE=""
QUIET=""
SIMULATE=""
WITH_TESTS=""

# ============================================
# Helper Functions
# ============================================
print_header() {
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "$1"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

print_step() { echo "> $1"; }
print_success() { echo "[OK] $1"; }
print_warning() { echo "[!] $1"; }
print_error() { echo "[ERROR] $1"; }
print_info() { [ -z "$QUIET" ] && echo "  $1"; }

showexec() {
    [ -z "$QUIET" ] && echo "+ $*"
    [ -z "$SIMULATE" ] && "$@"
}

# Convert service name to Maven module path
service_to_module() {
    local svc=$1
    case $svc in
        dataset-access|aip-access|bundle-plan|data-bundle|cache-mgmt|restricted-access|version-service)
            echo "services/$svc"
            ;;
        eureka-server|api-gateway|config-server)
            echo "infrastructure/$svc"
            ;;
        shared-exceptions|shared-models|shared-utils|cache-manager-client|dataset-access-client)
            echo "common/$svc"
            ;;
        *)
            echo ""
            ;;
    esac
}

# Convert service name to Docker container name
service_to_container() {
    local svc=$1
    echo "oar-dds-$svc"
}

# Check if service is healthy
check_health() {
    local name=$1
    local port=$(get_service_port "$name")

    if [ -z "$port" ]; then
        echo "unknown"
        return
    fi

    # Special handling for non-Spring services
    case $name in
        postgres)
            if docker exec oar-dds-postgres pg_isready -U oar_app > /dev/null 2>&1; then
                echo "UP"
            else
                echo "DOWN"
            fi
            return
            ;;
        redis)
            if docker exec oar-dds-redis redis-cli ping > /dev/null 2>&1; then
                echo "UP"
            else
                echo "DOWN"
            fi
            return
            ;;
    esac

    # Spring Boot health endpoint
    local status=$(curl -s --max-time 3 "http://localhost:$port/actuator/health" 2>/dev/null | \
        python3 -c "import sys,json; print(json.load(sys.stdin).get('status','DOWN'))" 2>/dev/null || echo "DOWN")
    echo "$status"
}

