# ============================================
# BUILD COMMANDS
# ============================================
cmd_build() {
    local services=()
    local skip_tests="-DskipTests"

    # Parse arguments
    for arg in "$@"; do
        if [ "$arg" = "--with-tests" ]; then
            skip_tests=""
        else
            services+=("$arg")
        fi
    done

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Building All Services"
        if [ -z "$skip_tests" ]; then
            print_step "Running tests..."
        fi
        showexec mvn clean package $skip_tests
    else
        for svc in "${services[@]}"; do
            local module=$(service_to_module "$svc")
            if [ -z "$module" ]; then
                print_error "Unknown service: $svc"
                continue
            fi
            print_header "Building: $svc"
            showexec mvn clean package -pl "$module" -am $skip_tests
        done
    fi
    print_success "Build complete"
}

cmd_build_common() {
    print_header "Building Common Modules"
    local modules=""
    for mod in "${COMMON_MODULES[@]}"; do
        modules="$modules,common/$mod"
    done
    modules=${modules:1}  # Remove leading comma
    showexec mvn clean install -pl "$modules" -DskipTests
    print_success "Common modules built"
}

cmd_clean() {
    print_header "Cleaning Build Artifacts"
    showexec mvn clean
    print_success "Clean complete"
}

# ============================================
# TEST COMMANDS
# ============================================
cmd_test() {
    local services=("$@")

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Running All Unit Tests"
        showexec mvn test
    else
        for svc in "${services[@]}"; do
            local module=$(service_to_module "$svc")
            if [ -z "$module" ]; then
                print_error "Unknown service: $svc"
                continue
            fi
            print_header "Testing: $svc"
            showexec mvn test -pl "$module"
        done
    fi
}

cmd_test_api() {
    print_header "Running API Contract Tests (Microservices Only)"

    if [ ! -f "tests/api_contract_test.py" ]; then
        print_error "API contract tests not found: tests/api_contract_test.py"
        exit 1
    fi

    # Check dependencies
    if ! python3 -c "import pytest" 2>/dev/null; then
        print_warning "Installing test dependencies..."
        pip3 install -r tests/requirements.txt
    fi

    showexec python3 -m pytest tests/api_contract_test.py -v -k "microservices"
}

cmd_test_api_compare() {
    print_header "Running API Comparison Tests (vs Monolith)"

    local monolith_url=${MONOLITH_URL:-http://localhost:9090}
    print_info "Monolith URL: $monolith_url"
    print_info "Set MONOLITH_URL environment variable to change"
    echo ""

    showexec python3 -m pytest tests/api_contract_test.py -v -k "compare"
}

cmd_test_report() {
    print_header "Generating HTML Test Report"

    showexec python3 -m pytest tests/api_contract_test.py -v -k "microservices" \
        --html=test-report.html \
        --self-contained-html \
        --capture=tee-sys

    print_success "Report generated: test-report.html"

    # Try to open the report
    if command -v open &> /dev/null; then
        open test-report.html
    elif command -v xdg-open &> /dev/null; then
        xdg-open test-report.html
    fi
}

# ============================================
# DOCKER COMMANDS
# ============================================
cmd_start() {
    local services=("$@")

    # Check config server first
    local config_status=$(check_health "config-server")
    if [ "$config_status" != "UP" ]; then
        print_warning "Config server not running. Start it first:"
        echo "  $prog config-server-start"
        echo ""
    fi

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Starting All Services"
        showexec docker-compose up -d
    else
        print_header "Starting: ${services[*]}"
        showexec docker-compose up -d "${services[@]}"
    fi

    echo ""
    print_step "Waiting for services to initialize..."
    sleep 5
    cmd_status
}

cmd_stop() {
    local services=("$@")

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Stopping All Services"
        showexec docker-compose down
    else
        print_header "Stopping: ${services[*]}"
        showexec docker-compose stop "${services[@]}"
    fi
    print_success "Services stopped"
}

cmd_restart() {
    local services=("$@")

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Restarting All Services"
        showexec docker-compose restart
    else
        print_header "Restarting: ${services[*]}"
        showexec docker-compose restart "${services[@]}"
    fi

    echo ""
    sleep 3
    cmd_status
}

cmd_rebuild() {
    local services=("$@")

    if [ ${#services[@]} -eq 0 ]; then
        print_header "Rebuilding All Services"
        showexec mvn clean package -DskipTests
        showexec docker-compose build
        showexec docker-compose up -d
    else
        for svc in "${services[@]}"; do
            print_header "Rebuilding: $svc"
            local module=$(service_to_module "$svc")
            if [ -n "$module" ]; then
                showexec mvn clean package -pl "$module" -am -DskipTests
            fi
            showexec docker-compose build "$svc"
            showexec docker-compose up -d "$svc"
        done
    fi

    echo ""
    sleep 3
    cmd_status
}

cmd_ps() {
    print_header "Docker Containers"
    docker-compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || docker-compose ps
}

cmd_logs() {
    local service=$1
    local follow=""

    # Check for -f flag
    for arg in "$@"; do
        [ "$arg" = "-f" ] && follow="-f"
    done

    if [ -z "$service" ] || [ "$service" = "-f" ]; then
        docker-compose logs --tail=50 $follow
    else
        local container=$(service_to_container "$service")
        docker logs "$container" --tail=50 $follow 2>&1
    fi
}

# ============================================
# STATUS COMMANDS
# ============================================
cmd_status() {
    print_header "Service Status"

    echo ""
    printf "  %-20s %-8s %s\n" "SERVICE" "PORT" "STATUS"
    printf "  %-20s %-8s %s\n" "-------" "----" "------"

    # Infrastructure
    for svc in "config-server" "eureka-server" "api-gateway" "postgres" "redis"; do
        local port=$(get_service_port "$svc")
        local status=$(check_health "$svc")
        printf "  %-20s %-8s %s\n" "$svc" "$port" "$status"
    done

    echo ""

    # Application services
    for svc in "${SERVICES[@]}"; do
        local port=$(get_service_port "$svc")
        local status=$(check_health "$svc")
        printf "  %-20s %-8s %s\n" "$svc" "$port" "$status"
    done

    echo ""
}

cmd_eureka() {
    print_header "Eureka Registered Services"

    local services=$(curl -s "http://localhost:8761/eureka/apps" 2>/dev/null | \
        grep -o '<name>[^<]*</name>' | sed 's/<[^>]*>//g' | sort -u)

    if [ -n "$services" ]; then
        echo "$services" | while read svc; do
            print_success "$svc"
        done
    else
        print_warning "No services registered (Eureka may still be starting)"
    fi
    echo ""
}

cmd_ports() {
