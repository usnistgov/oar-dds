# ============================================
# DATABASE COMMANDS
# ============================================
cmd_db_shell() {
    print_header "Database Shell (oar_cache)"
    docker exec -it oar-dds-postgres psql -U oar_app -d oar_cache
}

cmd_db_query() {
    local sql="$*"
    if [ -z "$sql" ]; then
        print_error "Usage: $prog db-query 'SELECT * FROM volumes'"
        exit 1
    fi
    docker exec oar-dds-postgres psql -U oar_app -d oar_cache -c "$sql"
}

cmd_db_volumes() {
    print_header "Cache Volume Statistics"
    docker exec oar-dds-postgres psql -U oar_app -d oar_cache -c "
        SELECT
            v.name,
            v.capacity,
            COUNT(o.objid) as file_count,
            COALESCE(SUM(o.size), 0) as total_size,
            CASE v.status
                WHEN 0 THEN 'disabled'
                WHEN 1 THEN 'readonly'
                WHEN 2 THEN 'updating'
                WHEN 3 THEN 'active'
                ELSE 'unknown'
            END as status
        FROM volumes v
        LEFT JOIN objects o ON v.id = o.volume
        GROUP BY v.id, v.name, v.capacity, v.status
        ORDER BY v.name;
    "
}

cmd_db_clear() {
    print_header "Clear Cache Inventory"
    print_warning "This will delete all cached object records from the database."
    read -p "Are you sure? (y/N) " confirm
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        docker exec oar-dds-postgres psql -U oar_app -d oar_cache -c "DELETE FROM objects;"
        print_success "Cache inventory cleared"
    else
        print_info "Cancelled"
    fi
}

# ============================================
# CONFIG COMMANDS
# ============================================
cmd_config() {
    local service=$1

    if [ -z "$service" ]; then
        print_header "Available Configurations"
        echo ""
        echo "  Services:"
        for svc in "${SERVICES[@]}"; do
            local name="${svc//-/-}"
            echo "    $svc → ${name}-service.yml"
        done
        echo ""
        echo "  Usage: $prog config <service>"
        echo ""
        return
    fi

    local config_name
    case $service in
        dataset-access) config_name="dataset-access-service" ;;
        aip-access) config_name="aip-access-service" ;;
        bundle-plan) config_name="bundle-plan-service" ;;
        data-bundle) config_name="data-bundle-service" ;;
        cache-mgmt) config_name="cache-management-service" ;;
        restricted-access) config_name="restricted-access-service" ;;
        version-service) config_name="version-service" ;;
        *) config_name="$service" ;;
    esac

    print_header "Configuration: $config_name"
    curl -s "http://localhost:8888/$config_name/default" 2>/dev/null | \
        python3 -m json.tool 2>/dev/null || \
        print_error "Could not fetch configuration. Is config-server running?"
}

cmd_config_refresh() {
    local service=$1

    if [ -z "$service" ]; then
        print_header "Refreshing All Service Configurations"
        for svc in "${SERVICES[@]}"; do
            local port=$(get_service_port "$svc")
            print_step "Refreshing $svc..."
            curl -s -X POST "http://localhost:$port/actuator/refresh" 2>/dev/null
        done
    else
        local port=$(get_service_port "$service")
        if [ -z "$port" ]; then
            print_error "Unknown service: $service"
            exit 1
        fi
        print_header "Refreshing Configuration: $service"
        curl -s -X POST "http://localhost:$port/actuator/refresh" 2>/dev/null
    fi
    print_success "Configuration refresh requested"
}

cmd_config_server_start() {
    print_header "Starting Config Server"

    local config_jar="/Users/one1/oar-config/oar-config-server/target/oar-config-server-1.2.0.jar"

    if [ ! -f "$config_jar" ]; then
        print_error "Config server JAR not found: $config_jar"
        echo "  Build it first:"
        echo "    cd /Users/one1/oar-config/oar-config-server"
        echo "    mvn clean package -DskipTests"
        exit 1
    fi

    # Check if already running
    if curl -s "http://localhost:8888/actuator/health" 2>/dev/null | grep -q "UP"; then
        print_warning "Config server already running on port 8888"
        return
    fi

    print_step "Starting config server on port 8888..."
    java -jar "$config_jar" --server.port=8888 > /tmp/config-server.log 2>&1 &

    # Wait for startup
    print_step "Waiting for config server to start..."
    for i in {1..30}; do
        if curl -s "http://localhost:8888/actuator/health" 2>/dev/null | grep -q "UP"; then
            print_success "Config server started"
            return
        fi
        sleep 1
    done

    print_error "Config server failed to start. Check /tmp/config-server.log"
}

cmd_config_server_stop() {
    print_header "Stopping Config Server"

    local pid=$(pgrep -f "oar-config-server.*8888" || true)
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        print_success "Config server stopped (PID: $pid)"
    else
        print_warning "Config server not running"
    fi
}

